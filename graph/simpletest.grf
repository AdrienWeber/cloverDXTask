<Phase number="0">
<Node aggregateKey="customerId" guiName="Aggregate" guiX="795" guiY="450" id="AGGREGATE" mapping="$customerId:=$customerId;$quantity:=sum($quantity);$amount:=sum($amount);" sorted="false" type="AGGREGATE"/>
<Node charset="UTF-8" fileURL="${DATAIN_DIR}/customers.txt" guiName="Customers" guiX="70" guiY="125" id="CUSTOMERS" type="DATA_READER"/>
<Node guiName="CustomerOrders" guiX="1270" guiY="300" id="CUSTOMER_ORDERS" joinKey="$customerId=$CUST_ID" type="EXT_HASH_JOIN">
<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	$out.0.custId = $in.0.customerId;
	$out.0.customerName = $in.1.CUST_NAME;
	$out.0.totalQty = $in.0.quantity;
	$out.0.totalAmt = $in.0.amount;

	return ALL;
}
