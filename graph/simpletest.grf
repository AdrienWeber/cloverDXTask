<Node guiName="FilterCustomers" guiX="320" guiY="250" id="FILTER_CUSTOMERS" type="EXT_FILTER">
<attr name="filterExpression"><![CDATA[//#CTL2
$in.0.STATE == "CA" || $in.0.STATE == "CO" || $in.0.STATE == "CT"]]></attr>
</Node>
<Node guiName="FilterItems" guiX="320" guiY="475" id="FILTER_ITEMS" type="EXT_FILTER">
<attr name="filterExpression"><![CDATA[//#CTL2
$in.0.Unit == "2-Liter"]]></attr>
</Node>
<Node guiName="FilterOrders" guiX="320" guiY="625" id="FILTER_ORDERS" type="EXT_FILTER">
<attr name="filterExpression"><![CDATA[//#CTL2
date2str($in.0.transDate, "yyyy") == "2014"]]></attr>
</Node>
<Node guiName="FilterTotalAmount" guiX="1020" guiY="400" id="FILTER_TOTAL_AMOUNT" type="EXT_FILTER">
<attr name="filterExpression"><![CDATA[//#CTL2
$in.0.quantity >= 30]]></attr>
</Node>
<Node fileURL="${DATAIN_DIR}/items.xlsx" guiName="Items" guiX="70" guiY="475" id="ITEMS" type="SPREADSHEET_READER"/>
<Node fileURL="${DATAIN_DIR}/orders.txt" guiName="orders" guiX="70" guiY="800" id="ORDERS" type="DATA_READER"/>
<Node guiName="OrderItems" guiX="570" guiY="550" id="ORDER_ITEMS" joinKey="$itemId=$ID" type="EXT_HASH_JOIN">
<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
    $out.0.customerId = $in.0.custId;
    $out.0.quantity   = $in.0.qty;
    $out.0.amount     = $in.0.qty * $in.1.UnitPrice;

    return ALL;
}

